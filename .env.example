# ================================
# DJANGO SETTINGS
# ================================
DEBUG=True
SECRET_KEY=django-secret-codemio-change-this
ALLOWED_HOSTS=localhost,127.0.0.1

# ================================
# DATABASE SETTINGS (MySQL)
# ================================
# Para docker-compose: usa estas variables
DB_NAME=codemio_db
DB_USER=codemio_user
DB_PASSWORD=codemio_password
DB_ROOT_PASSWORD=root_password
DB_PORT=3306

# Para conexión directa (desarrollo sin docker-compose)
# MySQL (PyMySQL vía settings). `mysql+pymysql://` se normaliza a `mysql://` para dj-database-url.
DATABASE_URL=mysql+pymysql://codemio_user:codemio_password@127.0.0.1:3306/codemio_db?charset=utf8mb4

# ================================
# DOCKER COMPOSE SETTINGS
# ================================
MYSQL_VERSION=8.0
DB_CONTAINER_NAME=codemio_mysql
WEB_CONTAINER_NAME=codemio_backend
WEB_PORT=8000
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=5

# ================================
# AWS COGNITO SETTINGS
# ================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_CLIENT_SECRET=your-client-secret
AWS_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id
AWS_COGNITO_DOMAIN=https://codemio-dev.auth.us-east-1.amazoncognito.com

# ================================
# CORS SETTINGS
# ================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# PROFILE PAYLOAD ENCRYPTION
# ================================
# Use single-line PEM values with \n escapes.
PROFILE_PAYLOAD_KEY_ID=profile-v1
PROFILE_PAYLOAD_RSA_PUBLIC_KEY_PEM=
PROFILE_PAYLOAD_RSA_PRIVATE_KEY_PEM=
