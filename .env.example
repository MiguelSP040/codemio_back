# Django settings
DEBUG=True
SECRET_KEY=django-secret-codemio
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings (MySQL; también compatible con PostgreSQL vía DATABASE_URL)
# MySQL (PyMySQL vía settings). `mysql+pymysql://` se normaliza a `mysql://` para dj-database-url.
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/codemio_db?charset=utf8mb4

# AWS Cognito settings
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_CLIENT_SECRET=your-client-secret
AWS_COGNITO_ISSUER=your-cognito-issuer-url
AWS_COGNITO_DOMAIN=your-cognito-domain

# Hosted UI
AWS_COGNITO_DOMAIN=https://codemio-dev.auth.us-east-1.amazoncognito.com

# Optional
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Payload encryption for PATCH /users/me/
# Use single-line PEM values with \n escapes.
PROFILE_PAYLOAD_KEY_ID=profile-v1
PROFILE_PAYLOAD_RSA_PUBLIC_KEY_PEM=
PROFILE_PAYLOAD_RSA_PRIVATE_KEY_PEM=

# Analysis settings (portable defaults through PATH)
ANALYSIS_PMD_COMMAND=pmd
ANALYSIS_SPOTBUGS_COMMAND=spotbugs
ANALYSIS_JAVAC_COMMAND=javac
ANALYSIS_TOOL_TIMEOUT_SECONDS=120
ANALYSIS_MAX_UPLOAD_BYTES=10485760
ANALYSIS_MAX_EXTRACTED_BYTES=31457280
ANALYSIS_MAX_EXTRACTED_FILES=500
ANALYSIS_PMD_RULESET=category/java/bestpractices.xml,category/java/errorprone.xml
