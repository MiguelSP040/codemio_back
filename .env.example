# ================================
# DJANGO SETTINGS
# ================================
DEBUG=True
SECRET_KEY=django-secret-codemio-change-this
ALLOWED_HOSTS=localhost,127.0.0.1

# ================================
# DATABASE SETTINGS (MySQL)
# ================================
# Para docker-compose: usa estas variables
DB_NAME=codemio_db
DB_USER=codemio_user
DB_PASSWORD=codemio_password
DB_ROOT_PASSWORD=root_password
DB_PORT=3306

# Para conexión directa (desarrollo sin docker-compose)
# MySQL (PyMySQL vía settings). `mysql+pymysql://` se normaliza a `mysql://` para dj-database-url.
DATABASE_URL=mysql+pymysql://codemio_user:codemio_password@127.0.0.1:3306/codemio_db?charset=utf8mb4

# ================================
# DOCKER COMPOSE SETTINGS
# ================================
MYSQL_VERSION=8.0
DB_CONTAINER_NAME=codemio_mysql
WEB_CONTAINER_NAME=codemio_backend
WEB_PORT=8000
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=5

# ================================
# AWS COGNITO SETTINGS
# ================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_CLIENT_SECRET=your-client-secret
AWS_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id
AWS_COGNITO_DOMAIN=https://codemio-dev.auth.us-east-1.amazoncognito.com

# ================================
# CORS SETTINGS
# ================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ================================
# PROFILE PAYLOAD ENCRYPTION
# ================================
# Use single-line PEM values with \n escapes.
PROFILE_PAYLOAD_KEY_ID=profile-v1
PROFILE_PAYLOAD_RSA_PUBLIC_KEY_PEM=
PROFILE_PAYLOAD_RSA_PRIVATE_KEY_PEM=


# Analysis settings
ANALYSIS_WORKERS=2
ANALYSIS_TOOL_TIMEOUT_SECONDS=120
ANALYSIS_MAX_UPLOAD_BYTES=10485760
ANALYSIS_MAX_EXTRACTED_BYTES=31457280
ANALYSIS_MAX_EXTRACTED_FILES=500
ANALYSIS_MAX_ZIP_ENTRIES=2000
ANALYSIS_MAX_ZIP_PATH_DEPTH=12
ANALYSIS_MAX_ZIP_COMPRESSION_RATIO=100.0
ANALYSIS_MAX_ZIP_ENTRY_BYTES=31457280
ANALYSIS_MAX_INFLIGHT_TASKS=50
ANALYSIS_RETRY_ATTEMPTS=2
ANALYSIS_RETRY_BACKOFF_SECONDS=1.5
ANALYSIS_GATE_MAX_SECURITY_RATING=1
ANALYSIS_GATE_MAX_RELIABILITY_RATING=1
ANALYSIS_GATE_MAX_MAINTAINABILITY_RATING=2
ANALYSIS_GATE_WARN_CODE_SMELLS_THRESHOLD=20
ANALYSIS_GATE_WARN_MIN_COVERAGE=60.0

# SonarCloud runtime analysis
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=
SONAR_ORGANIZATION=
SONAR_SCANNER_COMMAND=sonar-scanner
SONAR_RUNTIME_PROJECT_PREFIX=codemio-runtime
SONAR_QUALITYGATE_TIMEOUT_SECONDS=180
SONAR_API_TIMEOUT_SECONDS=30

# Webhook SonarCloud (POST /analysis/webhooks/sonar/) — HMAC SHA-256 del cuerpo; debe coincidir con el secret configurado en SonarCloud
SONAR_WEBHOOK_SECRET=
# Runs en WAITING_SONAR_WEBHOOK más antiguos que esto (minutos) pueden cerrarse vía `python manage.py reconcile_sonar_webhooks`
SONAR_WEBHOOK_STALE_MINUTES=45

# Logs estructurados event=... (pipeline, webhook Sonar, finalize, reconcile). Desactivar en producción.
DEBUG_ANALYSIS_INSTRUMENTATION=False
